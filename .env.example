# Supabase — projeto do Meal Planner
# Copie este arquivo para .env.local e preencha com as chaves do seu projeto.
# Painel: https://supabase.com/dashboard/project/_/settings/api

# Públicas: podem ir para o cliente (o RLS é quem protege os dados).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privada: NUNCA use em componentes com "use client" nem em código do browser.
# Ignora RLS por completo. Usada apenas em scripts de seed e rotinas de servidor.
SUPABASE_SERVICE_ROLE_KEY=
